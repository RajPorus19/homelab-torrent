# ─────────────────────────────────────────────
# Run: id $USER  to find your PUID and PGID
# ─────────────────────────────────────────────
PUID=1000
PGID=1000

# Your timezone — list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# Host LAN IP — used by Homer dashboard links
HOST_IP=192.168.1.104

# NordVPN credentials (your NordVPN account login)
NORDVPN_USER=your_nordvpn_user
NORDVPN_PASS=your_nordvpn_pass

# ─────────────────────────────────────────────
# Service credentials
# ─────────────────────────────────────────────

# qBittorrent Web UI (env-configured)
WEBUI_USERNAME=admin
WEBUI_PASSWORD=admin

# Prowlarr, Radarr, Sonarr, Jellyfin — set credentials on first-run wizard
# Bazarr — set credentials in Settings > Security after first launch
