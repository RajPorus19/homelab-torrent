# ─────────────────────────────────────────────
# Run: id $USER  to find your PUID and PGID
# ─────────────────────────────────────────────
PUID=1000
PGID=1000

# Your timezone — list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Paris

# Host LAN IP — used by Homer dashboard links
HOST_IP=192.168.1.100

# Local subnet (for qBittorrent LAN access behind the VPN)
# Find it with: ip route | grep default
LAN_NETWORK=192.168.1.0/24

# NordVPN credentials (your NordVPN account login)
NORDVPN_USER=your_nordvpn_user
NORDVPN_PASS=your_nordvpn_pass

# ─────────────────────────────────────────────
# Service credentials
# ─────────────────────────────────────────────

# qBittorrent Web UI (env-configured)
WEBUI_USERNAME=admin
WEBUI_PASSWORD=change_me

# Discord webhook for Diun update notifications (optional, leave empty to disable)
DISCORD_WEBHOOK=

# Prowlarr, Radarr, Sonarr, Jellyfin, Bazarr, Seerr:
# set credentials on first-run wizard / Settings > Security after first launch
